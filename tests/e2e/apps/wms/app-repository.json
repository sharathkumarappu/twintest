{
  "windows": [
    {
      "name": "SecurityWarning",
      "description": "ClickOnce 'Application Run - Security Warning' popup",
      "elements": [
        {
          "elementName": "RunButton",
          "selector": { "name": "Run" },
          "description": "Run button to accept the ClickOnce security warning"
        },
        {
          "elementName": "DontRunButton",
          "selector": { "name": "Don't Run" },
          "description": "Don't Run button to reject the ClickOnce app"
        }
      ]
    },
    {
      "name": "WMSApp",
      "description": "IMI Supply Chain Smart Client — main application window",
      "elements": []
    },
    {
      "name": "LoginPage",
      "description": "WMS login screen",
      "elements": [
        {
          "elementName": "UsernameInput",
          "selector": { "automationId": "UserFld" },
          "description": "Username text field"
        },
        {
          "elementName": "PasswordInput",
          "selector": { "className": "PasswordBox" },
          "description": "Password text field"
        },
        {
          "elementName": "LoginButton",
          "selector": { "name": "Login" },
          "description": "Login button"
        }
      ]
    },
    {
      "name": "ChangeUserSettingsPage",
      "description": "Change User Settings dialog that may appear after login",
      "elements": [
        {
          "elementName": "OKButton",
          "selector": { "name": "OK" },
          "description": "OK button to dismiss the dialog"
        },
        {
          "elementName": "CancelButton",
          "selector": { "name": "Cancel" },
          "description": "Cancel button"
        }
      ]
    },
    {
      "name": "ConfirmationPopupPage",
      "description": "Confirmation popup within the Smart Client",
      "elements": [
        {
          "elementName": "YesButton",
          "selector": { "xpath": "//Window[@Name='IMI Supply Chain Smart Client']//Button[@Name='Yes']" },
          "description": "Yes button on confirmation popup"
        }
      ]
    },
    {
      "name": "LeftPanelMenuPage",
      "description": "Left navigation panel of the Smart Client",
      "elements": [
        {
          "elementName": "StartButton",
          "selector": { "xpath": "//Button[@Name='Start']" },
          "description": "Start menu button"
        },
        {
          "elementName": "StartList",
          "selector": { "xpath": "//List[@AutomationId='startMenu']" },
          "description": "Start menu list"
        },
        {
          "elementName": "StartGroup",
          "selector": { "xpath": "//Group[@Name='Start']" },
          "description": "Start menu group"
        },
        {
          "elementName": "WarehouseButton",
          "selector": { "xpath": "//Button[@AutomationId='Warehouse']" },
          "description": "Warehouse navigation button"
        },
        {
          "elementName": "WarehouseGatewayButton",
          "selector": { "xpath": "//Button[@AutomationId='Gateway']" },
          "description": "Warehouse Gateway navigation button"
        },
        {
          "elementName": "TransportationButton",
          "selector": { "xpath": "//*[@AutomationId='Transportation']" },
          "description": "Transportation navigation button"
        },
        {
          "elementName": "OutputManagerButton",
          "selector": { "xpath": "//Button[@AutomationId='OutputManager']" },
          "description": "Output Manager navigation button"
        },
        {
          "elementName": "DockButton",
          "selector": { "xpath": "//Button[@AutomationId='Dock']" },
          "description": "Dock navigation button"
        }
      ]
    },
    {
      "name": "OutputManagerPage",
      "description": "Output Manager screen within the Smart Client",
      "elements": [
        {
          "elementName": "SearchButton",
          "selector": { "xpath": "//*[@Name='Output Manager']//*[@ClassName='PopupButton']" },
          "description": "Search popup button on the Output Manager page"
        },
        {
          "elementName": "MainUrlCell",
          "selector": { "xpath": "//DataGrid//DataItem[@AutomationId='Row_0']//Custom[@AutomationId='Cell_MainUrl']" },
          "description": "Main URL cell in the first row of the Output Manager data grid"
        },
        {
          "elementName": "FallbackUrlCell",
          "selector": { "xpath": "//DataGrid//DataItem[@AutomationId='Row_0']//Custom[@AutomationId='Cell_FallbackUrl']" },
          "description": "Fallback URL cell in the first row of the Output Manager data grid"
        }
      ]
    }
  ]
}
