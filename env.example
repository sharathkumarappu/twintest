# ── Application Under Test ────────────────────────────────────────────────
# APP_PATH: The application identifier passed to Appium's `appium:app` capability.
#   UWP / Store app:   Microsoft.WindowsCalculator_8wekyb3d8bbwe!App
#   Classic .exe:      C:\Path\To\YourApp.exe
#   ClickOnce:         C:\Users\<user>\AppData\Roaming\...\YourApp.appref-ms
#   Already running:   (leave empty — set APP_TOP_LEVEL_WINDOW instead)
APP_PATH=Microsoft.WindowsCalculator_8wekyb3d8bbwe!App

# APP_TOP_LEVEL_WINDOW: Hex window handle for attaching to an already-running app.
# Uncomment and set this INSTEAD of APP_PATH when testing a running process.
# Find it with: powershell -c "(Get-Process -Name 'yourapp').MainWindowHandle.ToString('X')"
# APP_TOP_LEVEL_WINDOW=0x00010A5C

# APP_WINDOW: The default window name in your app-repository.json.
# This sets `this.activeWindow` in step definitions. Can be overridden per-feature
# with: Given the active window is "YourWindowName"
APP_WINDOW=Calculator

# APP_REPO_PATH: Path to the app-repository.json for your application.
# Default: tests/e2e/data/app-repository.json
# For the calculator sample: tests/e2e/apps/calculator/app-repository.json
APP_REPO_PATH=tests/e2e/apps/calculator/app-repository.json

# ── Timeouts ──────────────────────────────────────────────────────────────
# ELEMENT_TIMEOUT: Default timeout (ms) for element waits in DesktopSteps.
ELEMENT_TIMEOUT=10000

# ── WMS Smart Client (ClickOnce) ──────────────────────────────────────────
# URL: ClickOnce deployment URL — the rundll32 dfshim.dll target.
URL=https://wms-dm-acc.ah.nl/IMIMenu/SmartClient_LB

# WMS_WINDOW_TITLE: Expected main window title after launch.
WMS_WINDOW_TITLE=IMI Supply Chain Smart Client

# WMS_PROCESS_NAME: Executable name for taskkill cleanup.
WMS_PROCESS_NAME=Imi.SupplyChain.UX.SmartClient.exe

# WMS_USER / WMS_PWD: Login credentials for the Smart Client.
WMS_USER=your_username
WMS_PWD=your_password

# DC_NAME: Data center name for warehouse context.
DC_NAME=DCH

# ── Database ──────────────────────────────────────────────────────────────
# SQL_DATABASE_USER / DB_USER: Oracle database username.
SQL_DATABASE_USER=your_db_user

# SQL_DATABASE_PASSWORD / DB_PASSWORD: Oracle database password.
SQL_DATABASE_PASSWORD=your_db_password

# SQL_DATABASE_URL / DB_URL: Oracle connect string (host:port/service).
SQL_DATABASE_URL=host:port/service

# GLN: Global Location Number.
GLN=0000000000000

# ── Appium ────────────────────────────────────────────────────────────────
# APPIUM_HOST: Appium server bind address.
APPIUM_HOST=127.0.0.1

# APPIUM_PORT: Appium server port.
APPIUM_PORT=4723
