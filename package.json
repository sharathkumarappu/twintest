{
  "name": "@twintest/framework",
  "version": "0.1.0",
  "description": "Windows desktop application test automation framework — Appium 2.x + appium-windows-driver + WebDriverIO + Cucumber-js with agent skills, harness hooks, and loop engineering.",
  "type": "module",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:repair": "node bin/self-repair.mjs",
    "appium:setup": "ts-node scripts/setup-appium.ts",
    "appium:start": "appium --address 127.0.0.1 --port 4723 --allow-cors",
    "appium:doctor": "appium driver doctor windows",
    "postinstall": "node scripts/postinstall.cjs",
    "build": "tsc --noEmit"
  },
  "bin": {
    "twintest-self-repair": "bin/self-repair.mjs"
  },
  "files": [
    "bin",
    "hooks",
    "skills",
    "schemas",
    "scripts/postinstall.cjs"
  ],
  "dependencies": {
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/cucumber-framework": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "appium": "^3.0.0",
    "cucumber-html-reporter": "^7.2.0",
    "dotenv": "^16.0.0",
    "oracledb": "^6.10.0",
    "webdriverio": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@wdio/types": "^9.0.0",
    "appium-windows-driver": "^6.1.1",
    "chai": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "winappdriver",
    "desktop-testing",
    "windows-automation",
    "cucumber",
    "webdriverio",
    "qa",
    "agent-skills",
    "agentic-testing"
  ],
  "author": "Sharath Kumar Shivaprasad",
  "license": "MIT"
}
